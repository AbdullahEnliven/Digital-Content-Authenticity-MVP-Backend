# ─── TrustVerify Backend — Environment Variables Template ────────────────────
# Copy this file to .env and fill in your own values. Never commit real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=TrustVerify Backend API
API_V1_STR=/api/v1
# development | production
ENVIRONMENT=development
# Set to false in production
DEBUG=true

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a long random string, e.g. `openssl rand -hex 32`
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./storage/uploads
CERTIFICATE_DIR=./storage/certificates
MAX_UPLOAD_SIZE_MB=15
ALLOWED_FILE_TYPES_STR=image/jpeg,image/png,image/webp,application/pdf,text/plain,audio/mpeg,audio/mp3,audio/wav,audio/x-wav,audio/flac,audio/x-flac,audio/mp4,audio/x-m4a,audio/ogg,application/ogg,video/mp4,video/webm,video/quicktime

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# e.g. http://localhost:5173,http://localhost:3000,https://your-frontend.up.railway.app
BACKEND_CORS_ORIGINS_STR=http://localhost:5173,http://localhost:3000

# ── ML Service ────────────────────────────────────────────────────────────────
# e.g. http://ml-service:9000 when running via Docker Compose
ML_SERVICE_URL=
MOCK_EXTERNAL_SERVICES=false

# ── Certificates ──────────────────────────────────────────────────────────────
DEFAULT_CERTIFICATE_VALIDITY_DAYS=730
